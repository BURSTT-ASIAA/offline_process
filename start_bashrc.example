## add the following to your $HOME/.bashrc
export PATH1=$PATH
alias bda="export PATH=$PATH:/data/kylin/bin:/home/ubuntu/shwang/script; export PYTHONPATH=/data/kylin/bin:/data/kylin/integral:/data/kylin/beamform:/home/ubuntu/shwang/script:$PYTHONPATH; . mod_activate.sh bursttda; export LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/linux/compiler/lib/intel64_lin:$LD_LIBRARY_PATH"
alias bda_off="conda deactivate; module rm python/miniconda3; export PATH=$PATH1; unset PYTHONPATH"

alias rfsoc="export PATH=$PATH:$HOME/rfsoc/python_zcu216:$HOME/rfsoc/python_zcu216/config_arp; . /data/kylin/bin/mod_activate.sh rfsoc; cd $HOME/rfsoc/python_zcu216"
alias rfsoc_off="conda deactivate; module rm python/miniconda3; export PATH=$PATH1"

myterms () {
	# create 3 terminals and connect them to a server
	if [ -z $1 ]; then
		CMD=''
	else
		CMD="-- ssh $1"
	fi
	gnome-terminal --geometry 105x24+0+0 $CMD
	gnome-terminal --geometry 105x24+0-0 $CMD
	gnome-terminal --geometry 95x40-0-0 $CMD
}
